# Public analytics IDs — baked into every production build (they ship in page
# source by design; not secrets).
#
# Clarity: switched to Marc's own project (y7j3r1bt7b). The old id y7wx5f1j03
# was Oz's project, so sessions were recording into an account Marc doesn't own.
#
# GA4: G-00R0V7TRZV is the pre-split property. CONFIRM Marc's Google account
# actually owns/admins it before trusting this data — if it doesn't, make a new
# GA4 property and replace the id here.
VITE_GA_ID=G-00R0V7TRZV
VITE_CLARITY_ID=y7j3r1bt7b

# Supabase (accounts + saved data). The URL and the publishable key are public
# by design: the browser talks to Supabase directly and Row Level Security is
# what protects the data, not the key. The secret key lives only in Netlify.
VITE_SUPABASE_URL=https://ghekylqfodslbipoayrl.supabase.co
VITE_SUPABASE_KEY=sb_publishable_tiyE8kJousZZQ-j09eIm8A_OEYW-yFm
